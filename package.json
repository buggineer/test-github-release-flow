{
  "name": "test-github-release-flow",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build --mode $npm_config_mode",
    "type-check": "vue-tsc --build",
    "lint": "echo 'lint: ok (stand-in, no linter in this sandbox)'",
    "test": "echo 'test: ok (stand-in, no tests in this sandbox)'",
    "copy-robots": "cp -v ./src/assets/robots/$npm_config_mode/robots.txt ./dist/robots.txt",
    "copy-assetlinks": "mkdir -p ./dist/.well-known && cp -v -r ./src/assets/assetlinks/$npm_config_mode/.well-known/* ./dist/.well-known"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
